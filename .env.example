# Local dev only — atlasflow doesn't read this file. Set real env vars
# in the atlasflow dashboard instead, under the project's Runtime
# Variables (not Build Variables — see README → "Environment variables
# on atlasflow" for why that distinction matters).

# Required for hosted-mode chat (the default) — app.py's /api/llm-call
# proxy forwards to Mistral using this key. Get one at
# https://console.mistral.ai/. Without it, hosted-mode chat requests fail
# with a 500 ("Server is not configured with an LLM API key"); the rest of
# the app (browsing datasets, Settings, "Custom endpoint" mode) still works.
MISTRAL_KEY=

# Required to run eval/gepa_optimize.py or eval/browser_harness.py — same
# key as above, read directly by those scripts via python-dotenv rather
# than through the Flask app.

# Uncomment to run on a different port locally. Defaults to 3000 to
# match what atlasflow requires — see README → "Deploying to atlasflow".
# PORT=3000

# Add further secrets here as this app grows, following the same NAME=
# convention. Never commit a filled-in .env — it's gitignored on purpose.
